{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "master"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/*.css", "!.github/scripts", "!_article"]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "playwright": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noNoninteractiveTabindex": "warn",
        "noSvgWithoutTitle": "off"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "useExhaustiveDependencies": "warn",
        "noPlaywrightMissingAwait": "error"
      },
      "performance": {
        "noDelete": "error",
        "noBarrelFile": "error",
        "noImgElement": "off",
        "useTopLevelRegex": "error"
      },
      "style": {
        "useBlockStatements": "off",
        "useConsistentArrayType": "warn",
        "useExportType": "warn",
        "useImportType": "warn",
        "useNamingConvention": {
          "level": "error",
          "options": { "strictCase": false }
        },
        "noPlaywrightElementHandle": "warn",
        "noPlaywrightEval": "warn",
        "noPlaywrightWaitForSelector": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noLeakedRender": "warn",
        "noPlaywrightForceOption": "error",
        "noPlaywrightNetworkidle": "error",
        "noPlaywrightPagePause": "error",
        "noPlaywrightWaitForNavigation": "error",
        "noPlaywrightWaitForTimeout": "error"
      },
      "complexity": {
        "noPlaywrightUselessAwait": "warn"
      }
    },
    "includes": ["**", "!_article", "!build/**", "!public/**", "!**/*.config.js"]
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["src/app/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/index", "**/index.*"],
                    "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"
                  },
                  {
                    "group": ["@/lib/distLoader/*", "@/lib/distLoader/**"],
                    "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"
                  }
                ]
              }
            },
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.stories.{ts,tsx}", "src/ui/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/**/*.{ts,tsx}", "!src/components/**/*.stories.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "error"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.{ts,tsx}", "tools/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/index", "**/index.*"],
                    "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**/page.tsx", "src/app/**/_lib/*Page.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/ui/styled": {
                    "importNames": ["css", "styled"],
                    "message": "page.tsx にスタイルを定義しないでください。src/components/Page/ の対応する場所に定義して import してください"
                  }
                },
                "patterns": [
                  {
                    "group": ["**/index", "**/index.*"],
                    "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"
                  },
                  {
                    "group": ["@/lib/distLoader/*", "@/lib/distLoader/**"],
                    "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/App/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/index", "**/index.*"],
                    "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"
                  },
                  {
                    "group": ["@/lib/distLoader/*", "@/lib/distLoader/**"],
                    "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"
                  },
                  {
                    "group": ["~/styled-system/*", "~/styled-system/**"],
                    "message": "@/ui/styled 経由で import してください"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/UI/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/index", "**/index.*"],
                    "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"
                  },
                  {
                    "group": ["@/components/UI/*/*", "@/components/UI/*/**", "!@/components/UI/Layout/*"],
                    "message": "UI module の内部ファイルを直接 import しないでください。公開入口を経由してください"
                  },
                  {
                    "group": ["@/lib/distLoader/*", "@/lib/distLoader/**"],
                    "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"
                  },
                  {
                    "group": ["@/components/App/*", "@/components/App/**"],
                    "message": "UI層からApp層への依存は禁止されています"
                  },
                  {
                    "group": ["@/components/Page/*", "@/components/Page/**"],
                    "message": "UI層からPage層への依存は禁止されています"
                  },
                  {
                    "group": ["@/components/Functional/*", "@/components/Functional/**"],
                    "message": "UI層からFunctional層への依存は禁止されています"
                  },
                  {
                    "group": ["~/styled-system/*", "~/styled-system/**"],
                    "message": "@/ui/styled 経由で import してください"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/Functional/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/index", "**/index.*"],
                    "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"
                  },
                  {
                    "group": ["@/lib/distLoader/*", "@/lib/distLoader/**"],
                    "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"
                  },
                  {
                    "group": ["@/components/App/*", "@/components/App/**"],
                    "message": "Functional層からApp層への依存は禁止されています"
                  },
                  {
                    "group": ["@/components/Page/*", "@/components/Page/**"],
                    "message": "Functional層からPage層への依存は禁止されています"
                  },
                  {
                    "group": ["@/components/UI/*", "@/components/UI/**"],
                    "message": "Functional層からUI層への依存は禁止されています"
                  },
                  {
                    "group": ["~/styled-system/*", "~/styled-system/**"],
                    "message": "@/ui/styled 経由で import してください"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/Page/_shared/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/index", "**/index.*"],
                    "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"
                  },
                  {
                    "group": ["@/lib/distLoader/*", "@/lib/distLoader/**"],
                    "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"
                  },
                  {
                    "group": ["@/components/App/*", "@/components/App/**"],
                    "message": "Page/_shared層からApp層への依存は禁止されています"
                  },
                  {
                    "group": ["@/components/Page/Archive/*", "@/components/Page/Archive/**"],
                    "message": "Page/_shared層から個別Page層への依存は禁止されています"
                  },
                  {
                    "group": ["@/components/Page/Home/*", "@/components/Page/Home/**"],
                    "message": "Page/_shared層から個別Page層への依存は禁止されています"
                  },
                  {
                    "group": ["@/components/Page/NotFound/*", "@/components/Page/NotFound/**"],
                    "message": "Page/_shared層から個別Page層への依存は禁止されています"
                  },
                  {
                    "group": ["@/components/Page/Post/*", "@/components/Page/Post/**"],
                    "message": "Page/_shared層から個別Page層への依存は禁止されています"
                  },
                  {
                    "group": ["@/components/Page/Single/*", "@/components/Page/Single/**"],
                    "message": "Page/_shared層から個別Page層への依存は禁止されています"
                  },
                  {
                    "group": ["~/styled-system/*", "~/styled-system/**"],
                    "message": "@/ui/styled 経由で import してください"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/Page/Archive/**/*.{ts,tsx}",
        "src/components/Page/Home/**/*.{ts,tsx}",
        "src/components/Page/NotFound/**/*.{ts,tsx}",
        "src/components/Page/Post/**/*.{ts,tsx}",
        "src/components/Page/Single/**/*.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/index", "**/index.*"],
                    "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"
                  },
                  {
                    "group": ["@/lib/distLoader/*", "@/lib/distLoader/**"],
                    "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"
                  },
                  {
                    "group": ["@/components/App/*", "@/components/App/**"],
                    "message": "Page層からApp層への依存は禁止されています"
                  },
                  {
                    "group": ["~/styled-system/*", "~/styled-system/**"],
                    "message": "@/ui/styled 経由で import してください"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**/*.{ts,tsx}", "!src/lib/source/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/index", "**/index.*"],
                    "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
