{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "nextjs"],
  "categories": { "correctness": "error" },
  "options": { "reportUnusedDisableDirectives": "warn" },
  "ignorePatterns": ["_article", ".github/scripts", "public/**", "**/*.config.js"],
  "rules": {
    "no-unused-vars": ["error", {"ignoreRestSiblings": true}],
    "oxc/no-barrel-file": ["error", {"threshold": 0}],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": ["warn", {"disallowTypeAnnotations": false}],
    "react/exhaustive-deps": "warn",
    "react/no-array-index-key": "error",
    "jsx-a11y/no-noninteractive-tabindex": "warn",
    "nextjs/no-img-element": "off",
    "nextjs/no-assign-module-variable": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "react/set-state-in-effect": "off",
    "unicorn/no-useless-spread": "off"
  },
  // 各 override の no-restricted-imports から barrel（**/index）の patterns を省かない。src の override は ~/build/** の patterns も省かない。
  // 同じ rule の options は後ろの override が丸ごと置き換えるため、省いた層では barrel import や build の import が通る
  "overrides": [
    {
      "files": ["src/app/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["@/lib/distLoader/*", "@/lib/distLoader/**"], "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"},
              {"group": ["~/build/**"], "message": "src から build を import しないでください。build はビルド時だけに動くコードです"}
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**/*.{ts,tsx}"],
      "excludeFiles": ["src/components/**/*.stories.{ts,tsx}"],
      "rules": {
        "import/no-default-export": "error"
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["~/build/**"], "message": "src から build を import しないでください。build はビルド時だけに動くコードです"}
            ]
          }
        ]
      }
    },
    // この override を src/**/*.{ts,tsx} の override より前へ動かさない。後ろが options を置き換え、css・styled の禁止が効かなくなる
    {
      "files": ["src/app/**/page.tsx", "src/app/**/_lib/*Page.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {"name": "@/ui/styled", "importNames": ["css", "styled"], "message": "page.tsx にスタイルを定義しないでください。src/components/Page/ の対応する場所に定義して import してください"}
            ],
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["@/lib/distLoader/*", "@/lib/distLoader/**"], "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"},
              {"group": ["~/build/**"], "message": "src から build を import しないでください。build はビルド時だけに動くコードです"}
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/App/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["@/lib/distLoader/*", "@/lib/distLoader/**"], "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"},
              {"group": ["~/styled-system/*", "~/styled-system/**"], "message": "@/ui/styled 経由で import してください"},
              {"group": ["~/build/**"], "message": "src から build を import しないでください。build はビルド時だけに動くコードです"}
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/UI/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["@/components/UI/*/*", "@/components/UI/*/**", "!@/components/UI/Layout/*"], "message": "UI module の内部ファイルを直接 import しないでください。公開入口を経由してください"},
              {"group": ["@/lib/distLoader/*", "@/lib/distLoader/**"], "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"},
              {"group": ["@/components/App/*", "@/components/App/**"], "message": "UI層からApp層への依存は禁止されています"},
              {"group": ["@/components/Page/*", "@/components/Page/**"], "message": "UI層からPage層への依存は禁止されています"},
              {"group": ["@/components/Functional/*", "@/components/Functional/**"], "message": "UI層からFunctional層への依存は禁止されています"},
              {"group": ["~/styled-system/*", "~/styled-system/**"], "message": "@/ui/styled 経由で import してください"},
              {"group": ["~/build/**"], "message": "src から build を import しないでください。build はビルド時だけに動くコードです"}
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/Functional/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["@/lib/distLoader/*", "@/lib/distLoader/**"], "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"},
              {"group": ["@/components/App/*", "@/components/App/**"], "message": "Functional層からApp層への依存は禁止されています"},
              {"group": ["@/components/Page/*", "@/components/Page/**"], "message": "Functional層からPage層への依存は禁止されています"},
              {"group": ["@/components/UI/*", "@/components/UI/**"], "message": "Functional層からUI層への依存は禁止されています"},
              {"group": ["~/styled-system/*", "~/styled-system/**"], "message": "@/ui/styled 経由で import してください"},
              {"group": ["~/build/**"], "message": "src から build を import しないでください。build はビルド時だけに動くコードです"}
            ]
          }
        ]
      }
    },
    // ~/build をすべては禁止しない。HTMLParser.integration.test.tsx が、変換器とそのキャッシュ（build の公開ファイル 2 つ）を import するため。内部の markdownToHtmlString/ の下は禁止のままにする
    {
      "files": ["src/components/Page/_shared/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["@/lib/distLoader/*", "@/lib/distLoader/**"], "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"},
              {"group": ["@/components/App/*", "@/components/App/**"], "message": "Page/_shared層からApp層への依存は禁止されています"},
              {"group": ["@/components/Page/Archive/*", "@/components/Page/Archive/**"], "message": "Page/_shared層から個別Page層への依存は禁止されています"},
              {"group": ["@/components/Page/Home/*", "@/components/Page/Home/**"], "message": "Page/_shared層から個別Page層への依存は禁止されています"},
              {"group": ["@/components/Page/NotFound/*", "@/components/Page/NotFound/**"], "message": "Page/_shared層から個別Page層への依存は禁止されています"},
              {"group": ["@/components/Page/Post/*", "@/components/Page/Post/**"], "message": "Page/_shared層から個別Page層への依存は禁止されています"},
              {"group": ["@/components/Page/Single/*", "@/components/Page/Single/**"], "message": "Page/_shared層から個別Page層への依存は禁止されています"},
              {"group": ["~/styled-system/*", "~/styled-system/**"], "message": "@/ui/styled 経由で import してください"},
              {"group": ["~/build/**", "!~/build/article/markdownToHtmlString", "!~/build/article/linkPreviewCache"], "message": "src から build を import しないでください。build はビルド時だけに動くコードです"}
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/Page/Archive/**/*.{ts,tsx}", "src/components/Page/Home/**/*.{ts,tsx}", "src/components/Page/NotFound/**/*.{ts,tsx}", "src/components/Page/Post/**/*.{ts,tsx}", "src/components/Page/Single/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["@/lib/distLoader/*", "@/lib/distLoader/**"], "message": "distLoader は src/lib/ 内からのみ import 可能です。Source または派生データの公開関数を経由してください"},
              {"group": ["@/components/App/*", "@/components/App/**"], "message": "Page層からApp層への依存は禁止されています"},
              {"group": ["~/styled-system/*", "~/styled-system/**"], "message": "@/ui/styled 経由で import してください"},
              {"group": ["~/build/**"], "message": "src から build を import しないでください。build はビルド時だけに動くコードです"}
            ]
          }
        ]
      }
    },
    {
      "files": ["src/lib/**/*.{ts,tsx}"],
      "excludeFiles": ["src/lib/source/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["~/build/**"], "message": "src から build を import しないでください。build はビルド時だけに動くコードです"}
            ]
          }
        ]
      }
    },
    // build が import してよい src を、個別の禁止の一覧にしない。@/** をすべて禁止し、共有の契約だけを除く。個別の禁止では、src に足したモジュールを build が import しても落ちない
    {
      "files": ["build/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {"group": ["**/index", "**/index.*"], "message": "index/barrel import は禁止です。公開ファイルを直接 import してください"},
              {"group": ["@/**", "!@/constants", "!@/types/*", "!@/lib/domain/embeddedContent", "!@/lib/tag/key", "!@/lib/search"], "message": "build が import してよい src は、build と runtime が共有する契約(constants・types・embeddedContent・tag/key・search)だけです。Source は dist を静的に import し、config は import した時点で環境変数を読む(build が loadEnvConfig を呼ぶより先に値が決まる)ため"},
              {"group": ["~/dist/**"], "message": "dist は ~/build/shared/dist の readDist・writeDist で読み書きしてください"}
            ]
          }
        ]
      }
    },
    // oxlint の組み込みプラグインに Playwright 用のものが無いため、ESLint 用の eslint-plugin-playwright を jsPlugins（alpha）で読む
    {
      "files": ["tests/**/*.{ts,tsx}"],
      "jsPlugins": ["eslint-plugin-playwright"],
      "rules": {
        "playwright/missing-playwright-await": "error",
        "playwright/no-force-option": "error",
        "playwright/no-networkidle": "error",
        "playwright/no-page-pause": "error",
        "playwright/no-wait-for-navigation": "error",
        "playwright/no-wait-for-timeout": "error",
        "playwright/no-element-handle": "warn",
        "playwright/no-eval": "warn",
        "playwright/no-wait-for-selector": "warn",
        "playwright/no-useless-await": "warn"
      }
    }
  ]
}
